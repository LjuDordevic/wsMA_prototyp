if SOC_SERIES_STM32L5X

rsource "/home/ljd/wsMA_prototyp/ZRTOS_demo/zephyr/soc/st/stm32/stm32l5x/soc/st/stm32/stm32l5x/Kconfig.defconfig.stm32l552xx"
rsource "/home/ljd/wsMA_prototyp/ZRTOS_demo/zephyr/soc/st/stm32/stm32l5x/soc/st/stm32/stm32l5x/Kconfig.defconfig.stm32l562xx"

config ICACHE
	default y

config CACHE_MANAGEMENT
	default y

choice CACHE_TYPE
	default EXTERNAL_CACHE
endchoice

config ROM_START_OFFSET
	default 0x400 if BOOTLOADER_MCUBOOT

