if SHIELD_ADAFRUIT_2_8_TFT_TOUCH_V2 || SHIELD_ADAFRUIT_2_8_TFT_TOUCH_V2_NANO

if DISPLAY

if LVGL

config LV_Z_VDB_SIZE
	default 64

config LV_Z_BITS_PER_PIXEL
	default 24

choice
	default LV_COLOR_DEPTH_32
endchoice
  default LV_COLOR_DEPTH_16 if LVGL && SHIELD_ARDUINO_GIGA_DISPLAY_SHIELD
  prompt "Color depth" if LVGL && SHIELD_ARDUINO_GIGA_DISPLAY_SHIELD
			help
				Color depth to be used.
			config LV_COLOR_DEPTH_32
    bool "32: XRGB8888" if LVGL
			config LV_COLOR_DEPTH_24
    bool "24: RGB888" if LVGL
			config LV_COLOR_DEPTH_16
    bool "16: RGB565" if LVGL
			config LV_COLOR_DEPTH_8
    bool "8: RGB232" if LVGL
			config LV_COLOR_DEPTH_1
    bool "1: 1 byte per pixel" if LVGL
endchoice

config INPUT
	default y

endif # LVGL

endif # DISPLAY

if DISK_DRIVERS

config DISK_DRIVER_SDMMC
	default y

endif # DISK_DRIVERS

endif # SHIELD_ADAFRUIT_2_8_TFT_TOUCH_V2
