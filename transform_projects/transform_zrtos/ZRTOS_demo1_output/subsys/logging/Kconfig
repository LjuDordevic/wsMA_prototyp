menu "Logging"

config LOG
	bool "Logging"
	select PRINTK if USERSPACE
	help
	  Global switch for the logger, when turned off log calls will not be
	  compiled in.

if LOG

config LOG_CORE_INIT_PRIORITY
	int "Log Core Initialization Priority"
	range 0 99
	default 0

source "subsys/logging/Kconfig.mode"

source "subsys/logging/Kconfig.filtering"

source "subsys/logging/Kconfig.processing"

if !LOG_MODE_MINIMAL

source "subsys/logging/Kconfig.formatting"

if !LOG_FRONTEND_ONLY

source "subsys/logging/backends/Kconfig"

endif # !LOG_FRONTEND_ONLY

endif # !LOG_MODE_MINIMAL

if LOG_FRONTEND

source "subsys/logging/frontends/Kconfig"

endif #LOG_FRONTEND

if LOG_MULTIDOMAIN

source "subsys/logging/Kconfig.links"

endif

source "subsys/logging/Kconfig.misc"

endif # LOG

config LOG_OUTPUT
	bool "Formatter helper"
	help
	  Module which provides formatting of log messages to a human-readable
	  strings.

endmenu
