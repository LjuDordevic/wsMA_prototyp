if SOC_FAMILY_ATMEL_SAM

source "soc/atmel/sam/sam3x/Kconfig.defconfig"
source "soc/atmel/sam/sam4e/Kconfig.defconfig"
source "soc/atmel/sam/sam4l/Kconfig.defconfig"
source "soc/atmel/sam/sam4s/Kconfig.defconfig"
source "soc/atmel/sam/samx7x/Kconfig.defconfig"

config CLOCK_CONTROL
	default y

config GPIO
	default y

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency)

config WATCHDOG
	default y

endif # SOC_FAMILY_ATMEL_SAM
