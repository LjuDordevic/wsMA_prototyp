config SOC_FAMILY_ESPRESSIF_ESP32
	bool

config SOC_FAMILY
	default "espressif_esp32" if SOC_FAMILY_ESPRESSIF_ESP32

source "soc/espressif/esp32/Kconfig.soc"
source "soc/espressif/esp32c2/Kconfig.soc"
source "soc/espressif/esp32c3/Kconfig.soc"
source "soc/espressif/esp32c6/Kconfig.soc"
source "soc/espressif/esp32s2/Kconfig.soc"
source "soc/espressif/esp32s3/Kconfig.soc"
