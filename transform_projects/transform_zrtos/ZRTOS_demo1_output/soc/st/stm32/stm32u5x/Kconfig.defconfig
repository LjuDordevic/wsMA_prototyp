if SOC_SERIES_STM32U5X

source "soc/st/stm32/stm32u5x/Kconfig.defconfig.stm32u535xx"
source "soc/st/stm32/stm32u5x/Kconfig.defconfig.stm32u545xx"
source "soc/st/stm32/stm32u5x/Kconfig.defconfig.stm32u575xx"
source "soc/st/stm32/stm32u5x/Kconfig.defconfig.stm32u585xx"
source "soc/st/stm32/stm32u5x/Kconfig.defconfig.stm32u595xx"
source "soc/st/stm32/stm32u5x/Kconfig.defconfig.stm32u599xx"
source "soc/st/stm32/stm32u5x/Kconfig.defconfig.stm32u5a5xx"
source "soc/st/stm32/stm32u5x/Kconfig.defconfig.stm32u5a9xx"
source "soc/st/stm32/stm32u5x/Kconfig.defconfig.stm32u5f9xx"
source "soc/st/stm32/stm32u5x/Kconfig.defconfig.stm32u5g9xx"

config ROM_START_OFFSET
	default 0x400 if BOOTLOADER_MCUBOOT

config ICACHE
	default y

config DCACHE
	default y

config CACHE_MANAGEMENT
	default y


if STM32_STOP3_LP_MODE

config COUNTER
	default y

config COUNTER_RTC_STM32_SUBSECONDS
	default y

config STM32_LPTIM_STDBY_TIMER
	default y

config TICKLESS_KERNEL
	default y

config COUNTER_RTC_STM32_SAVE_VALUE_BETWEEN_RESETS
	default y

config IDLE_STACK_SIZE
	default 512

endif #STM32_USE_STOP3

endif # SOC_SERIES_STM32U5X
