if SOC_SERIES_STM32L1X

source "soc/st/stm32/stm32l1x/Kconfig.defconfig.stm32l100xb"
source "soc/st/stm32/stm32l1x/Kconfig.defconfig.stm32l151xb"
source "soc/st/stm32/stm32l1x/Kconfig.defconfig.stm32l151xba"
source "soc/st/stm32/stm32l1x/Kconfig.defconfig.stm32l151xc"
source "soc/st/stm32/stm32l1x/Kconfig.defconfig.stm32l152xc"
source "soc/st/stm32/stm32l1x/Kconfig.defconfig.stm32l152xe"

# adjust the fallback because of the LSI oscaillator characteristics
config TASK_WDT_HW_FALLBACK_DELAY
	depends on TASK_WDT_HW_FALLBACK
	default 200

endif # SOC_SERIES_STM32L1X
