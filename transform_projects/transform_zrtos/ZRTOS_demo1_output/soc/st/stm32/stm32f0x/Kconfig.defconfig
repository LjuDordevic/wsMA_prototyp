# Kconfig symbols common to STM32F0 series

if SOC_SERIES_STM32F0X

source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f030x4"
source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f030x6"
source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f030x8"
source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f030xc"
source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f031x6"
source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f042x6"
source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f051x8"
source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f070xb"
source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f072xx"
source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f091xc"
source "soc/st/stm32/stm32f0x/Kconfig.defconfig.stm32f098xx"

config SRAM_VECTOR_TABLE
	default y

# adjust the fallback because of the LSI oscillator characteristics
config TASK_WDT_HW_FALLBACK_DELAY
	depends on TASK_WDT_HW_FALLBACK
	default 100

endif # SOC_SERIES_STM32F0X
