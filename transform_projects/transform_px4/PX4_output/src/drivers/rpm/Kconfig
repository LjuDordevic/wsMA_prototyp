menu "RPM"
    menuconfig COMMON_RPM
        bool "Common RPM drivers"
        default n
        select DRIVERS_RPM_PCF8583
        select DRIVERS_RPM_RPM_SIMULATOR
        help
            Enable default set of RPM drivers
    source "src/drivers/rpm/pcf8583/Kconfig"
    source "src/drivers/rpm/rpm_simulator/Kconfig"
endmenu
